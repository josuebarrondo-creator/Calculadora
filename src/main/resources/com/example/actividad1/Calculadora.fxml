<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="255.0" prefWidth="232.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.actividad1.CalculadoraC">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <TextField fx:id="Numero1" promptText="Ingresa un numero" />
   <ComboBox fx:id="Operacion" prefWidth="150.0" promptText="Elige una operacion" />
   <TextField fx:id="Numero2" promptText="Ingresa un numero" />

    <Label fx:id="Resultado" style="-fx-border-color: black; -fx-border-width: 2; -fx-padding: 5;" text="Resultado:">
      <VBox.margin>
         <Insets />
      </VBox.margin></Label>
    <Button fx:id="boton" onAction="#onHelloButtonClick" text="Calcular" />
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
</VBox>
